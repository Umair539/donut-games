#!/bin/bash
# Runs on every boot: installs Docker and cloudflared if needed, connects the Cloudflare Tunnel and
# runs the image from Artifact Registry on 127.0.0.1:8000, where only the tunnel can reach it.
# HTTPS is not handled here, Cloudflare provides it.
set -euxo pipefail

if ! command -v docker > /dev/null; then
  apt-get update
  apt-get install -y ca-certificates curl cron
  curl -fsSL https://get.docker.com | sh
fi

# From Cloudflare's own apt repository, which works over IPv6 (Docker Hub and GitHub may not)
if ! command -v cloudflared > /dev/null; then
  curl -fsSL https://pkg.cloudflare.com/cloudflare-main.gpg -o /usr/share/keyrings/cloudflare-main.gpg
  echo 'deb [signed-by=/usr/share/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared any main' \
    > /etc/apt/sources.list.d/cloudflared.list
  apt-get update
  apt-get install -y cloudflared
fi

# The token is written to a root-only file rather than put on the command line, where ps shows it.
# Its routes are set in Terraform (cloudflare.tf). The VM has no IPv4, so connect over IPv6.
install -d -m 700 /etc/cloudflared
set +x
install -m 600 /dev/null /etc/cloudflared/env
echo 'TUNNEL_TOKEN=${tunnel_token}' > /etc/cloudflared/env
set -x
echo 'TUNNEL_EDGE_IP_VERSION=6' >> /etc/cloudflared/env
cat > /etc/systemd/system/cloudflared.service <<'UNIT'
[Unit]
Description=Cloudflare Tunnel
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/cloudflared/env
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable cloudflared
systemctl restart cloudflared

mkdir -p /opt/donut-games
cat > /opt/donut-games/update.sh <<'UPDATE'
#!/bin/bash
# Pulls the latest image and restarts the server only if it changed. GitHub runs this over SSH
# after pushing an image, and cron runs it hourly in case that didn't happen.
set -euo pipefail
exec 9> /run/donut-update.lock
flock 9 # GitHub and cron at the same moment would both try to replace the container
image='${image}'
docker pull -q "$image" > /dev/null
latest=$(docker image inspect -f '{{.Id}}' "$image")
running=$(docker inspect -f '{{.Image}}' donut-games 2>/dev/null || true)
if [ "$latest" != "$running" ]; then
  # stop (not rm -f) so the server gets to save its rooms to the volume, and the new one
  # picks them up: players see a few seconds of "reconnecting" instead of losing their game
  docker stop -t 30 donut-games > /dev/null 2>&1 || true
  docker rm donut-games > /dev/null 2>&1 || true
  docker run -d --name donut-games --restart unless-stopped -p 127.0.0.1:8000:8000 \
    -v donut-data:/data -e ALLOWED_ORIGINS='${allowed_origins}' "$image" > /dev/null
  docker image prune -f > /dev/null
  echo "$(date -u +%FT%TZ) deployed $latest"
else
  echo "$(date -u +%FT%TZ) already running $latest"
fi
UPDATE
chmod +x /opt/donut-games/update.sh

# The user GitHub deploys as. Its key is forced to run update.sh (through sudo, which allows
# nothing else), so it can't get a shell, forward ports or run anything else.
id deploy > /dev/null 2>&1 || useradd --create-home --shell /bin/bash deploy
install -d -m 700 -o deploy -g deploy /home/deploy/.ssh
echo 'restrict,command="sudo /opt/donut-games/update.sh" ${deploy_ssh_key}' > /home/deploy/.ssh/authorized_keys
chown deploy:deploy /home/deploy/.ssh/authorized_keys
chmod 600 /home/deploy/.ssh/authorized_keys
echo 'deploy ALL=(root) NOPASSWD: /opt/donut-games/update.sh' > /etc/sudoers.d/deploy
chmod 440 /etc/sudoers.d/deploy

# 1 GB of RAM is tight, so add swap
if [ ! -f /swapfile ]; then
  fallocate -l 1G /swapfile && chmod 600 /swapfile && mkswap /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi
swapon /swapfile 2> /dev/null || true

# Normally GitHub deploys over SSH straight after a push. This catches a deploy that failed, and
# costs little: an unchanged image is only a small manifest check.
echo '0 * * * * root /opt/donut-games/update.sh >> /var/log/donut-update.log 2>&1' > /etc/cron.d/donut-games

# update.sh only replaces the container when the image changes, so remove it here too: a changed
# startup script (new docker run options) then takes effect on the next boot. Stopped first, so
# its rooms are saved.
docker stop -t 30 donut-games > /dev/null 2>&1 || true
docker rm donut-games > /dev/null 2>&1 || true
/opt/donut-games/update.sh || true
