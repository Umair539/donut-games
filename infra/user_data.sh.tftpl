#!/bin/bash
# Runs once on first boot: installs Docker and runs the image from private ECR on port 80.
# HTTPS is not handled here, Cloudflare's proxy provides it.
set -euxo pipefail

apt-get update
apt-get install -y ca-certificates curl cron awscli
curl -fsSL https://get.docker.com | sh

mkdir -p /opt/donut-games
cat > /opt/donut-games/aws-credentials <<'CREDS'
[default]
aws_access_key_id = ${access_key}
aws_secret_access_key = ${secret_key}
CREDS
chmod 600 /opt/donut-games/aws-credentials

cat > /opt/donut-games/update.sh <<'UPDATE'
#!/bin/bash
# Pulls the latest image and restarts the server only if it changed. Cron runs this every 5 minutes.
set -euo pipefail
image='${image}'
export AWS_SHARED_CREDENTIALS_FILE=/opt/donut-games/aws-credentials
aws ecr get-login-password --region ${region} | docker login --username AWS --password-stdin ${registry}
docker pull -q "$image" > /dev/null
latest=$(docker image inspect -f '{{.Id}}' "$image")
running=$(docker inspect -f '{{.Image}}' donut-games 2>/dev/null || true)
if [ "$latest" != "$running" ]; then
  docker rm -f donut-games 2> /dev/null || true
  docker run -d --name donut-games --restart unless-stopped -p 80:8000 "$image"
  docker image prune -f
fi
UPDATE
chmod +x /opt/donut-games/update.sh

# 512 MB of RAM is tight, so add swap
fallocate -l 1G /swapfile && chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile
echo '/swapfile none swap sw 0 0' >> /etc/fstab

# This is the deploy mechanism (GitHub can't SSH to an IPv6-only server), and it also covers
# the first boot, before any image has been pushed.
echo '*/5 * * * * root /opt/donut-games/update.sh >> /var/log/donut-update.log 2>&1' > /etc/cron.d/donut-games

/opt/donut-games/update.sh || true
